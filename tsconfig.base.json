{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@features/auth":           ["./features/auth/src/index.ts"],
      "@features/invoice":         ["./features/invoice/src/index.ts"],
      "@features/transaction":     ["./features/transaction/src/index.ts"],
      "@features/dashboard":        ["./features/dashboard/src/index.ts"],
      "@features/command-palette":  ["./features/command-palette/src/index.ts"],
      "@features/reports":         ["./features/reports/src/client/index.ts"],
      "@packages/shared-types":     ["./packages/shared-types/src/index.ts"],
      "@packages/common-utils":     ["./packages/common-utils/src/index.ts"]
    }
  }
}
