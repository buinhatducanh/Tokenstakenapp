{
  "name": "@tokens-taken/monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Tokens_taken \u2014 B2B Currency Management Platform",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "node api.js && vite build",
    "dev": "node api.js && vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "// \u2500\u2500 Workspace scripts \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500": "",
    "workspace:install": "pnpm install",
    "workspace:typecheck": "pnpm -r typecheck",
    "workspace:build": "pnpm -r build --if-present",
    "workspace:test": "pnpm -r test --if-present",
    "// \u2500\u2500 DB scripts \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500": "",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "// \u2500\u2500 Cleanup \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500": "",
    "clean": "rm -rf node_modules packages/*/node_modules features/*/node_modules apps/*/node_modules"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "pnpm": "^9.15.0",
    "prettier": "^3.3.0",
    "prisma": "5.22.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
