{
  "name": "@tokens-taken/monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Tokens_taken — B2B Currency Management Platform",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "// ── Workspace scripts ──────────────────────────────────": "",
    "workspace:install": "pnpm install",
    "workspace:typecheck": "pnpm -r typecheck",
    "workspace:build": "pnpm -r build --if-present",
    "workspace:test": "pnpm -r test --if-present",
    "// ── DB scripts ─────────────────────────────────────────": "",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "// ── Cleanup ────────────────────────────────────────────": "",
    "clean": "rm -rf node_modules packages/*/node_modules features/*/node_modules apps/*/node_modules"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cmdk": "^1.0.0",
    "eslint": "^9.0.0",
    "lucide-react": "^0.475.0",
    "pnpm": "^9.15.0",
    "prettier": "^3.3.0",
    "prisma": "5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-router": "^7.1.5",
    "sonner": "^2.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "6.3.5",
    "vitest": "^2.0.0"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.60.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.5.0"
  }
}
