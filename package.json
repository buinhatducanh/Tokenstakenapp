{
  "name": "@tokens-taken/monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Tokens_taken — B2B Currency Management Platform",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run --passWithNoTests",
    "// ── Workspace scripts ──────────────────────────────────": "",
    "workspace:install": "pnpm install",
    "workspace:typecheck": "pnpm -r typecheck",
    "workspace:build": "pnpm -r build --if-present",
    "workspace:test": "pnpm -r test --if-present",
    "// ── DB scripts ─────────────────────────────────────────": "",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "// ── Cleanup ────────────────────────────────────────────": "",
    "clean": "rimraf node_modules packages/*/node_modules features/*/node_modules apps/*/node_modules"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "pnpm": "^9.15.0",
    "prettier": "^3.3.0",
    "prisma": "5.22.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "pnpm": {},
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.0",
    "cmdk": "1.0.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "0.468.0",
    "next-themes": "^0.4.6",
    "react": "19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.0.0",
    "react-dropzone": "14.3.0",
    "react-hook-form": "^7.76.0",
    "react-resizable-panels": "^4.11.1",
    "react-router": "7.0.0",
    "recharts": "^2.15.0",
    "sonner": "1.7.0",
    "tailwind-merge": "2.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  }
}